{
  "entities": {
    "CaseStudy": {
      "title": "Case Study",
      "description": "A professional STAR format case study document.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "situation": { "type": "string" },
        "task": { "type": "string" },
        "action": { "type": "string" },
        "result": { "type": "string" },
        "primaryColor": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "situation", "task", "action", "result", "primaryColor", "authorId", "createdAt"]
    },
    "Contract": {
      "title": "Contract",
      "description": "A binding legal agreement between a freelancer and client.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientAddress": { "type": "string" },
        "freelancerName": { "type": "string" },
        "freelancerAddress": { "type": "string" },
        "projectName": { "type": "string" },
        "projectScope": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "fee": { "type": "string" },
        "governingState": { "type": "string" },
        "contractType": { "type": "string" },
        "content": { "type": "string" },
        "logo": { "type": "string" },
        "primaryColor": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "SENT", "VIEWED", "SIGNED"] },
        "freelancerSign": { "type": "string" },
        "clientSign": { "type": "string" },
        "signedAt": { "type": "string", "format": "date-time" },
        "clientIp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "clientName", "contractType", "content", "status", "createdAt"]
    },
    "HistoryItem": {
      "title": "History Item",
      "description": "A record of tool usage for a specific user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "toolId": { "type": "string" },
        "toolName": { "type": "string" },
        "timestamp": { "type": "number" },
        "data": { "type": "object" },
        "summary": { "type": "string" }
      },
      "required": ["userId", "toolId", "toolName", "timestamp", "summary"]
    },
    "CapacityRoster": {
      "title": "Capacity Roster",
      "description": "Team capacity and revenue projections.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "members": { "type": "array" },
        "agencyRate": { "type": "number" },
        "timeHorizon": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "members", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account tier and subscription data.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "planTier": { "type": "string", "enum": ["FREE", "PRO"] },
        "stripeCustomerId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "planTier"]
    },
    "CrmClient": {
      "title": "CRM Client",
      "description": "A client record in the Pro Mini-CRM.",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "contactName": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "contactName", "createdAt"]
    },
    "SavedItem": {
      "title": "Saved Item",
      "description": "Reusable invoice line item.",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "defaultRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "defaultRate"]
    }
  },
  "firestore": {
    "profiles/{uid}": {
      "schema": "UserProfile",
      "description": "User profile and subscription tier."
    },
    "users/{uid}/clients/{id}": {
      "schema": "CrmClient",
      "description": "Pro CRM contacts for a user."
    },
    "users/{uid}/items/{id}": {
      "schema": "SavedItem",
      "description": "Saved reusable invoice items."
    },
    "caseStudies/{id}": {
      "schema": "CaseStudy",
      "description": "Publicly shared case studies generated by the Portfolio Builder."
    },
    "contracts/{id}": {
      "schema": "Contract",
      "description": "Legal contracts for signing and management."
    },
    "history/{id}": {
      "schema": "HistoryItem",
      "description": "User tool usage history logs."
    },
    "capacity/{userId}": {
      "schema": "CapacityRoster",
      "description": "User-specific team capacity planning data."
    }
  }
}
